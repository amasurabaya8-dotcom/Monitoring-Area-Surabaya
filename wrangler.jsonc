{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monitoring-area-surabaya",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Project Supabase: monitoring-area-surabaya (ap-southeast-1)
    // Publishable key memang untuk publik; data dilindungi RLS (anon hanya bisa SELECT).
    "SUPABASE_URL": "https://cxnrczsfxdyaiknagtth.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_mFXmcMVQ0aMzng2DWExVkQ_FtCOKgy0"
  },
  "observability": { "enabled": true }
}
